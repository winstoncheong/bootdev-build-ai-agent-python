# Copy to .env and fill in: cp .env.example .env (.env is gitignored)
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OpenCode Go / Console (https://opencode.ai/console)
OPENCODE_API_KEY=
# Cheap + tool-capable options: muse-spark-1.3-contributor ($0.10/$0.20,
# cheapest but trains on data — needs privacy opt-in), mimo-v2.6-flash
# ($0.14/$0.28), glm-5.3-flash ($0.15/$0.50), qwen3.8-flash,
# deepseek-v4.1-flash (off-peak $0.15/$0.60)
OPENCODE_MODEL=muse-spark-1.3-contributor
